        ]
      }
    },
    "stats-1": {
      "type": "js.stats",
      "props": {
        "direction": "responsive"
      },
      "slots": {
        "items": [
          "stat-1",
          "stat-2",
          "stat-3"
        ]
      }
    },
    "stat-1": {
      "type": "js.stat",
      "props": {
        "title": "Components",
        "value": "88",
        "description": "All built from daisyUI guides",
        "icon": "sparkles"
      }
    },
    "stat-2": {
      "type": "js.stat",
      "props": {
        "title": "Guides covered",
        "value": "68",
        "description": "Every daisyUI guide",
        "icon": "check"
      }
    },
    "stat-3": {
      "type": "js.stat",
      "props": {
        "title": "Themes",
        "value": "4",
        "description": "Switch from the navbar",
        "icon": "sun"
      }
    },
    "section-2": {
      "type": "js.section",
      "props": {
        "width": "wide",
        "paddingY": "lg",
        "gap": "lg",
        "background": "base_200"
