    "hero-1": {
      "type": "js.hero",
      "props": {
        "variant": "image",
        "heading": "daisyUI on Drupal Canvas",
        "text": "<p>A full component library, built from every daisyUI guide and ready to place in the Canvas editor.</p>",
        "backgroundImage": {
          "src": "https://picsum.photos/seed/mountain-landscape/1600/900",
          "alt": "Mountain landscape",
          "width": 1600,
          "height": 900
        },
        "overlay": true,
        "minHeight": "half"
      },
      "slots": {
        "actions": [
          "button-1",
          "button-2"
        ]
      }
    },
    "button-1": {
      "type": "js.button",
      "props": {
        "text": "Open the style guide",
        "link": "/style-guide",
        "color": "primary"
      }
    },
    "button-2": {
      "type": "js.button",
      "props": {
        "text": "See pricing",
        "link": "/pricing"
      }
    },
    "section-1": {
      "type": "js.section",
